/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    // GPUDevice and related WebGPU types resolve for
    // hdr-display.service.ts and hdr-grid-renderer.ts without
    // importing core modules. Declared here and in tsconfig.spec.json
    // separately: app and spec compile disjoint file sets (this config
    // excludes *.spec.ts below), so each needs its own ambient-types
    // entry.
    "types": ["@webgpu/types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
