/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // Matches tsconfig.app.json: hdr-grid-renderer.spec.ts references
    // GPUDevice-typed stubs. Repeated rather than shared with
    // tsconfig.app.json because this config compiles the disjoint
    // *.spec.ts file set.
    "types": ["vitest/globals", "@webgpu/types"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
